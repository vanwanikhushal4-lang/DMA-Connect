{
  "auth": {
    "authorizedDomains": [
      "localhost",
      "127.0.0.1",
      "dma-connect-foundation.firebaseapp.com",
      "dma-connect-foundation.web.app"
    ],
    "providers": {
      "emailPassword": true
    }
  },
  "firestore": {
    "database": "dma-connect",
    "edition": "enterprise",
    "location": "asia-south1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "auth": {
      "port": 19099
    },
    "firestore": {
      "port": 18180,
      "edition": "enterprise"
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true,
    "functions": {
      "port": 15001
    },
    "storage": {
      "port": 19199
    },
    "hub": {
      "port": 14400
    },
    "logging": {
      "port": 14500
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "dma-connect",
      "runtime": "nodejs24"
    }
  ],
  "storage": {
    "rules": "storage.rules"
  }
}
