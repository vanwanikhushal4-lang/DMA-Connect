{
  "auth": {
    "authorizedDomains": [
      "localhost",
      "127.0.0.1",
      "dma-connect-foundation.firebaseapp.com",
      "dma-connect-foundation.web.app"
    ],
    "providers": {
      "emailPassword": true
    }
  },
  "firestore": {
    "database": "dma-connect",
    "edition": "enterprise",
    "location": "asia-south1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "auth": {
      "host": "0.0.0.0",
      "port": 9099
    },
    "firestore": {
      "host": "0.0.0.0",
      "port": 8180,
      "edition": "enterprise"
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true,
    "functions": {
      "host": "0.0.0.0",
      "port": 5001
    },
    "storage": {
      "host": "0.0.0.0",
      "port": 9199
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "dma-connect",
      "runtime": "nodejs24"
    }
  ],
  "storage": {
    "rules": "storage.rules"
  }
}
