// accounts/{uid}: trusted uid/personId/role/level/committeeId/status metadata.
// people/{id}: private name/email/mobile/residence/dob/socials/photoPaths,
// birthday preferences, canonical identity and server-derived scope IDs.
// committees/{id}: active catalogue and hierarchy without private contact data.
// requests/{id}: applicantUid/personId/committeeId/status, one committee decision.
// affiliations/{id}: personId/committeeId/status, independent committee membership.
// workspaceEvents/{uid}: server timestamp for real-time invalidation.
// phoneIndex/invitations/activity/birthdayDeliveries/system/access: server only.
// Every client mutation is denied. Callable backend validators and transactions
// enforce field validity, immutable identity, scoped appointments and transitions.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() { return request.auth != null; }
    function isOwner(uid) { return isAuthenticated() && request.auth.uid == uid; }
    function ownsPerson(id) {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/accounts/$(request.auth.uid))
        && get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.personId == id;
    }
    function uidUnchanged(d) { return isAuthenticated() && d.uid == request.auth.uid; }
    function uidNotModified(d) { return d.uid == resource.data.uid; }
    function validString(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function isValidAccount(d) {
      return d.keys().hasAll(['uid','personId','role','status','committeeId'])
        && validString(d.uid,1,128) && validString(d.personId,1,128)
        && d.role in ['superadmin','president','member']
        && d.status in ['active','suspended'];
    }
    function isValidPerson(d) {
      return d.keys().hasAll(['name','email','mobile','residence','dob','photoPaths','socials'])
        && validString(d.name,1,120) && validString(d.email,3,254)
        && validString(d.mobile,10,10) && validString(d.residence,1,500)
        && validString(d.dob,10,10) && d.photoPaths is list && d.photoPaths.size() <= 3;
    }
    function isValidRequest(d) { return validString(d.personId,1,128) && d.status in ['pending','approved','declined','withdrawn']; }
    function isValidAffiliation(d) { return validString(d.personId,1,128) && d.status in ['active','left','suspended']; }
    match /accounts/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create: if false && isValidAccount(request.resource.data) && uidUnchanged(request.resource.data);
      allow update: if false && isValidAccount(request.resource.data) && uidNotModified(request.resource.data);
      allow delete: if false;
    }
    match /people/{id} {
      allow get: if ownsPerson(id);
      allow list: if false;
      allow create, update: if false && isValidPerson(request.resource.data);
      allow delete: if false;
    }
    match /committees/{id} {
      allow read: if isAuthenticated() && resource.data.active == true;
      allow write: if false;
    }
    match /requests/{id} {
      allow read: if isAuthenticated() && resource.data.applicantUid == request.auth.uid;
      allow create, update: if false && isValidRequest(request.resource.data);
      allow delete: if false;
    }
    match /affiliations/{id} {
      allow read: if ownsPerson(resource.data.personId);
      allow create, update: if false && isValidAffiliation(request.resource.data);
      allow delete: if false;
    }
    match /workspaceEvents/{uid} { allow get: if isOwner(uid); allow list, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
