{
  "expo": {
    "name": "DMA Connect",
    "slug": "dma-connect",
    "scheme": "dma-connect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.dmafoundation.connect",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "package": "org.dmafoundation.connect",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "DMA Connect",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/foundation-logo.png",
          "imageWidth": 110
        }
      ],
      [
        "@react-native-firebase/app",
        {
          "ios": {
            "disableSPM": true
          }
        }
      ],
      "@react-native-firebase/auth",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow DMA Connect to choose your member photographs.",
          "cameraPermission": "Allow DMA Connect to take your member photograph.",
          "microphonePermission": false
        }
      ],
      "./plugins/with-ios-path-support.cjs"
    ]
  }
}
