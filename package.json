{
  "name": "dma-connect",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo/metro-runtime": "~57.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/auth": "^26.4.0",
    "expo": "~57.0.27",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.25",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "firebase": "^13.0.0",
    "lucide-react-native": "^1.53.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:rules": "npx --yes firebase-tools@latest emulators:exec --only firestore --project demo-dma-connect \"node --test tests/firestore-rules.mjs\"",
    "test:integration": "npx --yes firebase-tools@latest emulators:exec --config firebase.workflow-test.json --only auth,firestore,functions,storage --project demo-dma-community \"node tests/community.e2e.mjs\"",
    "postinstall": "node scripts/patch-expo-paths.cjs",
    "test:workflow": "npx --yes firebase-tools@latest emulators:exec --config firebase.workflow-test.json --only auth,firestore,functions,storage --project demo-dma-workflow \"node tests/workflow.e2e.mjs\""
  },
  "private": true,
  "engines": {
    "node": ">=24.12.0"
  }
}
